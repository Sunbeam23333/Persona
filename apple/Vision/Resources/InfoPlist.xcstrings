{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude read and add calendar events when you ask, for example to check whether you are free on Friday afternoon or to book a meeting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeがカレンダーの予定を読み取り、追加できるようにします。たとえば金曜の午後が空いているか確認したり、会議を入れたりします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 看日程时，Persona 允许它读取和添加日历事件，比如看看周五下午有没有空，或者约一个会。"
          }
        }
      }
    },
    "NSCalendarsWriteOnlyAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona adds events to your calendar when you ask Claude to, for example to save a meeting it scheduled for you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeに依頼したときに、Personaがカレンダーに予定を追加します。たとえばClaudeが調整した会議を保存します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 添加日程时，Persona 把事件写进日历，比如保存它帮你约好的会议。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona uses the camera to scan the pairing QR code printed by `personad hub pair`, for example when you first connect to your hub."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaはカメラで`personad hub pair`が表示するペアリング用QRコードを読み取ります。たとえば初めてハブに接続するときに使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 用相机扫描 `personad hub pair` 打印的配对二维码，比如第一次连接你的 hub 时。"
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude look up your contacts when you ask, for example to find a colleague's phone number or email before drafting a message."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeが連絡先を調べられるようにします。たとえばメッセージを下書きする前に同僚の電話番号やメールアドレスを探します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 查联系人时，Persona 允许它读取通讯录，比如起草消息前找到同事的电话或邮箱。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona asks for Optic ID before it types a Mac's remembered password on that Mac's lock screen, when you tap One-Tap Unlock on the Mac's page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macのページで「ワンタップで解除」をタップすると、PersonaはOptic IDで確認してから、そのMacのロック画面に保存済みのパスワードを入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 的页面上点「一键解锁」时，Persona 先用 Optic ID 确认，再在那台 Mac 的锁屏上输入记住的密码。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona shares your current location with Claude only when you ask, for example to find what time it is where you are or which office you are in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときだけ、Personaは現在地をClaudeに伝えます。たとえば今いる場所の時刻や、どのオフィスにいるかを調べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有你让 Claude 用位置时，Persona 才把当前位置告诉它，比如查你所在地的时间，或者你在哪个办公室。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona records audio when you start a recording or dictate a message, for example a meeting or a spoken note. Recordings are transcribed on your device and only the text is saved to the knowledge base on your hub; the audio stays on your device."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音や音声入力を始めたときにPersonaが録音します。たとえば会議や口頭のメモです。録音はこのデバイス上で文字起こしされ、テキストだけがハブのナレッジに保存されます。音声はこのデバイスに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你开始录音或语音输入时，Persona 会录音，比如录一场会议或一段口述笔记。录音在本机上转成文字，只有文字存进 hub 上的知识库，音频留在本机上。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona saves images Claude produces to your library when you ask, for example a chart it generated."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときに、Claudeが作成した画像をPersonaが写真ライブラリに保存します。たとえば生成したグラフです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Persona 保存时，它把 Claude 生成的图片存进照片图库，比如它画的图表。"
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude look at recent photos when you ask, for example to read a screenshot you took or describe a whiteboard photo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeが最近の写真を見られるようにします。たとえば撮ったスクリーンショットを読んだり、ホワイトボードの写真を説明したりします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 看照片时，Persona 允许它查看最近的照片，比如读一张截图，或者描述一张白板照片。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona lets Claude read and create reminders when you ask, for example to add “review the PR” to your Today list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "依頼したときにClaudeがリマインダーを読み取り、作成できるようにします。たとえば「PRを確認する」を今日のリストに追加します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你让 Claude 管提醒事项时，Persona 允许它读取和新建提醒，比如把「看一下 PR」加到今天的列表里。"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona turns your voice into text when you hold the mic button, for example to dictate a reply to Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクボタンを押している間、Personaがあなたの声をテキストに変換します。たとえばClaudeへの返信を音声で入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住麦克风按钮时，Persona 把你的语音转成文字，比如口述一条给 Claude 的回复。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
