    {
      "name": "modifier_once",
      "description": "按点击、按住和发送事件更新修饰键状态。",
      "source": [
        "ios/Persona/Views/Chat/TerminalKeys.swift — TerminalModifiers.tap / hold / release / pressed / apply",
        "ios/PersonaTests/TerminalTests.swift — TerminalModifierTests",
        "ios/PersonaTests/TerminalTests.swift — tapArmsForOneKey"
      ],
      "input": {
        "probe_key": "c",
        "actions": [
          {
            "op": "tap",
            "modifier": "ctrl",
            "quick": false
          },
          {
            "op": "pressed"
          }
        ]
      },
      "expected": {
        "steps": [
          {
            "active": true,
            "alt": "off",
            "applied": "ctrl+c",
            "ctrl": "once",
            "shift": "off"
          },
          {
            "active": false,
            "alt": "off",
            "applied": "c",
            "ctrl": "off",
            "shift": "off"
          }
        ]
      },
      "from_test": "tapArmsForOneKey"
    },
