      "description": "直接编码键名字符串并保留别名和未知输入的现有处理。",
      "source": [
        "ios/Persona/Views/Session/Terminal/TerminalInput.swift — TerminalKeyBytes.encode"
      ],
      "input": {
        "name": "CONTROL+OPTION+UP"
      },
      "expected": {
        "bytes": "\u001b[1;7A",
        "utf8": [
          27,
          91,
          49,
          59,
          55,
          65
        ]
      },
      "derived": true
    },
