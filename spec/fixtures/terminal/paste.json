{
  "schema_version": 1,
  "kind": "paste",
  "cases": [
    {
      "name": "paste_plain",
      "description": "多行文本使用括号粘贴，CRLF 和 LF 转成 CR。",
      "source": [
        "ios/Persona/Views/Session/Terminal/TerminalInput.swift — TerminalKeyBytes.text",
        "ios/PersonaTests/TerminalWrapTests.swift — aPasteWithLinesIsOnePiece"
      ],
      "input": {
        "text": "ls -la"
      },
      "expected": {
        "bytes": "ls -la",
        "utf8": [
          108,
          115,
          32,
          45,
          108,
          97
        ]
      },
      "from_test": "aPasteWithLinesIsOnePiece"
    },
