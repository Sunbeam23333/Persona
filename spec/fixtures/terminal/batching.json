{
  "schema_version": 1,
  "kind": "batch",
  "cases": [
    {
      "name": "batch_text_then_keys",
      "description": "按文本在前、键在后的请求顺序分批，并撤回未发送字符。",
      "source": [
        "ios/Persona/Views/Session/Terminal/TerminalInput.swift — KeyBatcher.push / take",
        "ios/PersonaTests/TerminalWrapTests.swift — KeyBatcherTests",
        "ios/PersonaTests/TerminalWrapTests.swift — textThenKeysGoInOneRequest"
      ],
      "input": {
        "events": [
          {
            "text": "l"
          },
          {
            "text": "s"
          },
          {
            "key": "enter"
          },
          {
            "key": "up"
          }
        ]
      },
      "expected": {
        "empty": true,
        "requests": [
          {
            "keys": [
              "enter",
              "up"
            ],
            "text": "ls"
          }
        ]
      },
      "from_test": "textThenKeysGoInOneRequest"
    },
    {
      "name": "batch_text_after_key",
      "description": "按文本在前、键在后的请求顺序分批，并撤回未发送字符。",
      "source": [
        "ios/Persona/Views/Session/Terminal/TerminalInput.swift — KeyBatcher.push / take",
        "ios/PersonaTests/TerminalWrapTests.swift — KeyBatcherTests",
        "ios/PersonaTests/TerminalWrapTests.swift — textAfterAKeyWaitsForTheNextRequest"
      ],
      "input": {
        "events": [
          {
            "key": "esc"
          },
          {
            "text": "a"
          },
          {
            "key": "tab"
          },
          {
            "text": "b"
          }
        ]
      },
      "expected": {
        "empty": true,
        "requests": [
          {
            "keys": [
              "esc"
            ],
            "text": ""
          },
          {
            "keys": [
              "tab"
            ],
            "text": "a"
          },
          {
            "keys": [],
            "text": "b"
          }
        ]
      },
      "from_test": "textAfterAKeyWaitsForTheNextRequest"
    },
    {
