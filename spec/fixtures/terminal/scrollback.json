      "description": "解析 ANSI 历史行并保留内部空行和样式。",
      "source": [
        "ios/Persona/Views/Session/Terminal/TerminalGrid.swift — rows(fromANSI:) / plain",
        "ios/PersonaTests/TerminalGridTests.swift — scrollbackPagesAreRowsOfColoredText"
      ],
      "input": {
        "text": "\u001b[0m\u001b[31mred\u001b[0m plain\r\n\r\nnext 中\r\n"
      },
      "expected": {
        "row_lengths": [
          9,
          0,
          7
        ],
        "style_runs": [
          {
            "from": 0,
            "row": 0,
            "style": {
              "fg": {
                "indexed": 1
              }
            },
            "to": 3
          }
        ],
        "text": [
          "red plain",
          "",
          "next 中\ufff0"
        ],
        "wide_cells": [
          [
            2,
            5,
            2
          ],
          [
            2,
            6,
            0
          ]
        ]
      },
      "from_test": "scrollbackPagesAreRowsOfColoredText"
    },
