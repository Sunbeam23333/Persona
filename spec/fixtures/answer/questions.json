{
  "schema_version": 1,
  "cases": [
    {
      "name": "single_tap_sends_original_label",
      "description": "单题单选点击后立即发送带推荐后缀的原文。",
      "source": [
        "ios/Persona/Views/Interactions/InteractionViews.swift：QuestionForm",
        "ios/Shared/Models.swift：Resolution"
      ],
      "input": {
        "profile": "ios_current",
        "interaction": {
          "id": "example_request",
          "machine_id": "example_machine",
          "session_id": "example_session",
          "kind": "question",
          "questions": [
            {
              "question": "选择展示方式？",
              "header": "展示",
              "multi_select": false,
              "options": [
                {
                  "label": "简洁 (Recommended)"
                },
                {
                  "label": "完整"
                },
                {
                  "label": "仅摘要"
                }
              ]
            }
          ]
        },
        "operation": {
          "action": "pick_option",
          "page": 0,
          "picks": {},
          "other": {},
          "sending": false,
          "option_index": 0
        }
      },
      "expected": {
        "allowed": true,
        "resolution": {
          "answers": {
            "选择展示方式？": "简洁 (Recommended)"
          }
        }
      },
      "derived": true
    },
