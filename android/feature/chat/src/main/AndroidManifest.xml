<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Voice input: Android 11+ only sees the phone's speech recognizer when the app declares it wants to. -->
    <queries>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>
    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.chat.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chat_file_paths" />
        </provider>
    </application>
</manifest>
